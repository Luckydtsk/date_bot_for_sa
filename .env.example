# Токен от @BotFather
BOT_TOKEN=1234567890:ABCDEF_your_bot_token_here

# Telegram user id админов через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789,987654321

# Локально — SQLite, файл рядом с проектом. Его нельзя удалять: это и есть анкеты.
# Перезапуск бота данные не стирает. На сервере лучше путь ./data/ball_bot.db и том Docker.
DATABASE_URL=sqlite+aiosqlite:///./ball_bot.db

# Опционально: Redis для FSM (несколько инстансов / переживание рестартов). Без него — MemoryStorage.
# REDIS_URL=redis://localhost:6379/0
